{
  "name": "wtf-rent",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tailwindcss build --input ./app/public/app.css --output ./app/public/out.css",
    "dev": "pnpm run --parallel /^dev:.*/",
    "dev:server": "NODE_ENV=development node --watch --import remix/node-tsx --env-file-if-exists .env server.ts",
    "dev:css": "node --run build -- --watch",
    "hmr:css": "node --run build -- --watch",
    "hmr:server": "NODE_ENV=development node --env-file-if-exists .env hmr.ts",
    "hmr": "pnpm run --parallel /^hmr:.*/",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "pretest": "node --run build",
    "test": "NODE_ENV=test remix test",
    "test:browser": "NODE_ENV=test remix test --type browser",
    "pretest:e2e": "node --run build",
    "test:e2e": "NODE_ENV=test remix test --type e2e",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@mcansh/http-helmet": "^0.13.2",
    "@node-rs/bcrypt": "^1.10.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "pg": "^8.23.0",
    "railway": "^3.11.0",
    "redis": "^6.2.1",
    "remix": "3.0.0-beta.10"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.24.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
