{
  "name": "wtf-rent",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tailwindcss build --input ./app/public/app.css --output ./app/public/out.css",
    "dev": "pnpm run --parallel /^dev:.*/",
    "dev:server": "NODE_ENV=development node --watch --import remix/node-tsx --env-file-if-exists .env server.ts",
    "dev:css": "node --run build -- --watch",
    "hmr:css": "node --run build -- --watch",
    "hmr:server": "NODE_ENV=development node --env-file-if-exists .env hmr.ts",
    "hmr": "pnpm run --parallel /^hmr:.*/",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --import remix/node-tsx --test 'app/**/*.test.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@mcansh/http-helmet": "^0.13.2",
    "@node-rs/bcrypt": "^1.10.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "pg": "^8.23.0",
    "railway": "^3.10.0",
    "remix": "3.0.0-beta.10"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
