{
  "name": "wtf-rent",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tailwindcss build --input ./app/public/app.css --output ./app/public/out.css",
    "dev": "pnpm run --parallel /^dev:.*/",
    "dev:server": "NODE_ENV=development node --watch --import remix/node-tsx --env-file-if-exists .env server.ts",
    "dev:css": "node --run build -- --watch",
    "hmr:css": "node --run build -- --watch",
    "hmr:server": "NODE_ENV=development node --env-file-if-exists .env hmr.ts",
    "hmr": "pnpm run --parallel /^hmr:.*/",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "pretest": "node --run build",
    "test": "NODE_ENV=test node --import remix/node-tsx --test 'app/**/*.test.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@mcansh/http-helmet": "^0.13.2",
    "@node-rs/bcrypt": "^1.10.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "pg": "^8.23.0",
    "railway": "^3.10.0",
    "remix": "3.0.0-beta.10"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "warn"
    }
  }
}
